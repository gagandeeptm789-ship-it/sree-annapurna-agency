# Sree Annapurna Agency — Backend Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB connection URI (required for accounts, orders, payments, and invoices)
# Enter your private MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Security
# Generate a unique secret with at least 32 characters; required in production.
# Keep this value private and do not reuse a secret from another application.
JWT_SECRET=

# Owner Operations Portal Passcode (required for owner sign-in)
# Set a private passcode; do not use a default or commit the real value.
OWNER_PASSCODE=admin123

# Payment Gateway Configuration (Optional - Razorpay)
# Configure both Razorpay keys to enable Razorpay payment verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional local-development-only payment simulation key.
# Simulation is disabled in production and requires this key to be set.
TEST_PAYMENT_SECRET=
