# Sree Annapurna Agency — Backend Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
# Enter your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication & Security
# Set a strong unique secret for JWT signing in production
JWT_SECRET=saa-master-secret-key-fmcg-2026-sree-annapurna-agency

# Owner Operations Portal Passcode
OWNER_PASSCODE=annapurna2026

# Payment Gateway Configuration (Optional - Razorpay)
# Leave empty to run in built-in offline/sandbox simulation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
